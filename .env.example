TENANCIT_ADDR=:8080
TENANCIT_DATABASE_URL=postgres://postgres:tenancit@localhost:5432/tenancit?sslmode=disable
TENANCIT_ADMIN_AUTH_MODE=legacy_shared_token
TENANCIT_DEV_MODE=true
TENANCIT_ADMIN_TOKEN=change-me-at-least-16-chars
# Produção: use OIDC e remova o modo/token legado acima.
# TENANCIT_ADMIN_AUTH_MODE=oidc
# TENANCIT_ADMIN_ORIGIN=https://tenancit.example.com
# TENANCIT_OIDC_ISSUER=https://id.example.com/realms/platform
# TENANCIT_OIDC_CLIENT_ID=tenancit
# TENANCIT_OIDC_CLIENT_SECRET=
# TENANCIT_OIDC_ROLE_CLAIM=groups
# TENANCIT_OIDC_ROLE_MAPPINGS={"/tenancit/viewers":"viewer","/tenancit/operators":"operator","/tenancit/security-admins":"security_admin"}
# Gere uma chave real com: openssl rand -base64 32
TENANCIT_AES_KEY=
TENANCIT_AES_KEY_VERSION=1
# Obrigatório em produção e no modo distribuído. Compose usa valkey:6379.
TENANCIT_VALKEY_URL=redis://localhost:6379/0
# Somente desenvolvimento explícito com uma réplica: memory
TENANCIT_RATE_LIMIT_MODE=valkey
# Optional additional keyring entry for a staged or historical version:
# TENANCIT_AES_KEY_V2=
