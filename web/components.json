{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "olive",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@cit": {
      "url": "https://gitlab.cithyper.click/api/v4/projects/centralit%2Fshadcn-cit/repository/files/public%2Fr%2F{name}.json/raw?ref=main",
      "headers": {
        "PRIVATE-TOKEN": "${CIT_REGISTRY_TOKEN}"
      }
    }
  }
}
